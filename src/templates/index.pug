extends layouts/_layout

block content
  a.skip-link(href="#about") Skip to main content
  header.site-header#top
    .center.site-header__inner
      a.brand.js-scroll(href="#top" aria-label="Vishwa S — home") VS
      nav.site-nav(aria-label="Primary navigation")
        button.site-nav__toggle.js-nav-toggle(type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Open navigation menu")
          span
          span
        ul.site-nav__menu.js-nav-menu#site-menu
          li: a.js-scroll(href="#about") About
          li: a.js-scroll(href="#experience") Experience
          li: a.js-scroll(href="#work") Work
          li: a.js-scroll(href="#skills") Skills
          li: a.js-scroll(href="#contact") Contact

  main
    section.hero(aria-labelledby="hero-title")
      img.hero__background(src="img/bg-main.jpg" alt="" width="1440" height="1000" aria-hidden="true")
      .center.hero__content
        .hero__copy
          p.hero__name(data-aos="transform") Vishwa S
          h1.hero__title#hero-title
            span(data-aos="transform" data-aos-delay="100") Software Developer building
            span(data-aos="transform" data-aos-delay="200") scalable enterprise applications
            span(data-aos="transform" data-aos-delay="300") with Angular and ASP.NET Core.
          p.hero__description(data-aos="animation-translate-y" data-aos-delay="400") I build responsive frontends, secure REST APIs, real-time workflows and maintainable distributed systems using Angular, .NET, Clean Architecture and CQRS.
          .hero__actions(data-aos="animation-translate-y" data-aos-delay="500")
            a.btn.btn_purple.js-scroll(href="#work") View My Work
            a.btn.btn_dark(href="resume/Vishwa-S-Resume.pdf" download) Download Resume
      .hero__art(data-aos="hero-cubes" aria-hidden="true")
        .hero__layer-wrap.hero__layer-wrap_1
          img.hero__layer.hero__layer_1(src="img/main-pic-6.png" alt="")
        .hero__layer-wrap.hero__layer-wrap_2
          img.hero__layer.hero__layer_2.js-parallax(src="img/main-pic-1.png" alt="" data-scale="2.5" data-orientation="up")
        .hero__layer-wrap.hero__layer-wrap_3
          img.hero__layer.hero__layer_3.js-parallax(src="img/main-pic-2.png" alt="" data-scale="1.5" data-orientation="up")
        .hero__layer-wrap.hero__layer-wrap_4
          img.hero__layer.hero__layer_4(src="img/main-pic-3.png" alt="")
        .hero__layer-wrap.hero__layer-wrap_5
          img.hero__layer.hero__layer_5(src="img/main-pic-4.png" alt="")
        .hero__layer-wrap.hero__layer-wrap_6
          img.hero__layer.hero__layer_6.js-parallax(src="img/main-pic-5.png" alt="" data-scale="4.5" data-orientation="up")
        .hero__layer-wrap.hero__layer-wrap_7
          img.hero__layer.hero__layer_7.js-parallax(src="img/main-pic-7.png" alt="" data-scale="1.5" data-orientation="down")

    section.section.section_light#about(aria-labelledby="about-title")
      .center
        .section-heading(data-aos="animation-scale-y")
          p.eyebrow Core expertise
          h2.section-title#about-title Engineering clear, dependable products.
          p.section-intro Software Developer specializing in Angular and ASP.NET Core, building secure, scalable and maintainable enterprise applications.
        .expertise-grid
          article.expertise-card.expertise-card_purple(data-aos="animation-translate-y")
            span.card-number 01
            h3 Angular Frontend Engineering
            p Responsive enterprise interfaces using Angular, TypeScript, RxJS, Reactive Forms, reusable components, SCSS, PrimeNG and Jest.
          article.expertise-card.expertise-card_orange(data-aos="animation-translate-y" data-aos-delay="120")
            span.card-number 02
            h3 ASP.NET Core Backend Engineering
            p Secure REST APIs and maintainable backend services using C#, ASP.NET Core, Entity Framework Core, LINQ, Clean Architecture, CQRS and MediatR.
          article.expertise-card.expertise-card_yellow(data-aos="animation-translate-y" data-aos-delay="240")
            span.card-number 03
            h3 Distributed Systems and Application Reliability
            p Real-time and distributed solutions using SignalR, RabbitMQ, gRPC, Redis, YARP, Serilog, retries, Dead Letter Queues and correlation IDs.

    section.section.section_dark.experience#experience(aria-labelledby="experience-title")
      .center
        .section-heading(data-aos="animation-scale-y")
          p.eyebrow Experience
          h2.section-title#experience-title Building production software across the stack.
        .timeline
          article.timeline__item(data-aos="animation-translate-y")
            .timeline__marker(aria-hidden="true")
            p.timeline__period August 2024 – Present
            h3 Software Developer
            p.timeline__company Propel Technology Group Inc.
            p Contributing across the software development lifecycle by building enterprise applications with Angular and ASP.NET Core. Developing reusable frontend components, secure REST APIs, scalable backend services and reliable distributed workflows while following Clean Architecture, CQRS and engineering best practices.
          article.timeline__item(data-aos="animation-translate-y" data-aos-delay="150")
            .timeline__marker(aria-hidden="true")
            p.timeline__period July 2023 – September 2023
            h3 Web Development Intern
            p.timeline__company DLK Technologies India Private Limited
            p Developed a secure messaging platform with LDAP Active Directory authentication and JWT verification. The work increased user engagement by 75% and reduced manual input by 50%.

    section.work-intro
      .center
        .work-intro__copy
          p.eyebrow Selected work
          h2.work-intro__title Building reliable software from interface to infrastructure.
          p.work-intro__text Practical engineering across responsive interfaces, secure APIs and distributed workflows.
      .work-intro__art(data-aos="animation-scale" aria-hidden="true")
        img.work-intro__layer.work-intro__layer_1.js-parallax(src="img/work-cube-1.png" alt="" width="1300" height="900" loading="lazy" data-scale="1.08" data-orientation="up")
        img.work-intro__layer.work-intro__layer_2.js-parallax(src="img/work-cube-2.png" alt="" width="1300" height="900" loading="lazy" data-scale="1.1" data-orientation="up left")
        img.work-intro__layer.work-intro__layer_3.js-parallax(src="img/work-cube-3.png" alt="" width="1300" height="900" loading="lazy" data-scale="1.12" data-orientation="up right")
        img.work-intro__layer.work-intro__layer_4(src="img/work-cube-4.png" alt="" width="1300" height="900" loading="lazy")
        img.work-intro__layer.work-intro__layer_5.js-parallax(src="img/work-cube-5.png" alt="" width="1300" height="900" loading="lazy" data-scale="1.08" data-orientation="left")
        img.work-intro__layer.work-intro__layer_6.js-parallax(src="img/work-cube-6.png" alt="" width="1300" height="900" loading="lazy" data-scale="1.1" data-orientation="right")
        img.work-intro__layer.work-intro__layer_7.js-parallax(src="img/work-cube-7.png" alt="" width="1300" height="900" loading="lazy" data-scale="1.12" data-orientation="down")

    section.section.section_gradient#work(aria-labelledby="work-title")
      .center
        .section-heading(data-aos="animation-scale-y")
          p.eyebrow Featured work
          h2.section-title#work-title Relevant products and contributions.
        .project-list
          article.project-card(data-aos="animation-translate-y")
            .project-card__visual.project-card__visual_purple(aria-hidden="true")
              .project-card__orbit
              img.project-cube.project-cube_partner-main.js-parallax(src="img/work-cube-5.png" alt="" width="1300" height="900" loading="lazy" data-scale="1.08" data-orientation="up")
              img.project-cube.project-cube_partner-accent.js-parallax(src="img/work-cube-1.png" alt="" width="1300" height="900" loading="lazy" data-scale="1.1" data-orientation="down")
              span.project-card__visual-title Enterprise Platform
            .project-card__body
              p.project-card__label Professional Work – Details Only
              h3 Partner Taxation Platform
              p An enterprise taxation platform developed using Angular and ASP.NET Core, with complex business workflows, secure APIs, real-time updates and distributed service communication.
              h4 Contribution highlights
              ul.check-list
                li Built reusable Angular components using RxJS, custom directives and Reactive Forms
                li Reduced application load time by 40% and CSS redundancy by 30%
                li Maintained more than 95% Jest unit-test coverage
                li Implemented SignalR real-time updates and D3.js visualizations
                li Built secure REST APIs with JWT and permission-based authorization
                li Used CQRS, MediatR, Clean Architecture, gRPC, RabbitMQ and Redis
                li Added retry mechanisms, Dead Letter Queues and distributed correlation IDs
                li Integrated Serilog, FluentValidation, centralized exception handling and Swagger/OpenAPI
          article.project-card.project-card_reverse(data-aos="animation-translate-y")
            .project-card__visual.project-card__visual_orange(aria-hidden="true")
              .project-card__orbit
              img.project-cube.project-cube_leave-main.js-parallax(src="img/work-cube-7.png" alt="" width="1300" height="900" loading="lazy" data-scale="1.08" data-orientation="down")
              img.project-cube.project-cube_leave-accent.js-parallax(src="img/work-cube-4.png" alt="" width="1300" height="900" loading="lazy" data-scale="1.1" data-orientation="up")
              span.project-card__visual-title LeaveTrack
            .project-card__body
              p.project-card__label In Development
              h3 LeaveTrack
              p A role-based leave-management system for Admins, Managers and Employees, built with Angular, ASP.NET Core, PostgreSQL and Entity Framework Core.
              h4 Capabilities
              ul.check-list
                li Employee, manager and hierarchy management
                li Leave requests, balances, approval and rejection workflows
                li JWT authentication and permission-based authorization
                li SignalR real-time notifications
                li Clean Architecture and CQRS with MediatR
                li Redis caching and YARP API Gateway
                li Optimistic concurrency for competing approvals
                li Swagger/OpenAPI documentation, Jest and backend automated testing

    section.section.section_light#skills(aria-labelledby="skills-title")
      .center
        .section-heading(data-aos="animation-scale-y")
          p.eyebrow Skills
          h2.section-title#skills-title A focused enterprise application toolkit.
        .skills-grid
          article.skill-group(data-aos="animation-translate-y")
            h3 Frontend
            p Angular · TypeScript · JavaScript · RxJS · Reactive Forms · PrimeNG · HTML · CSS · SCSS · Jest · D3.js
          article.skill-group(data-aos="animation-translate-y" data-aos-delay="80")
            h3 Backend
            p C# · ASP.NET Core · RESTful APIs · Microservices · Clean Architecture · CQRS · MediatR · Entity Framework Core · LINQ · FluentValidation
          article.skill-group(data-aos="animation-translate-y" data-aos-delay="160")
            h3 Distributed systems
            p RabbitMQ · gRPC · SignalR · Redis · YARP API Gateway · Correlation IDs · Retry Patterns · Dead Letter Queues
          article.skill-group(data-aos="animation-translate-y")
            h3 Security and observability
            p JWT · Role-Based Access Control · Permission-Based Authorization · Serilog · Centralized Exception Handling · Swagger/OpenAPI
          article.skill-group(data-aos="animation-translate-y" data-aos-delay="80")
            h3 Databases and tools
            p PostgreSQL · Oracle SQL · MySQL · GitHub · GitLab · Azure DevOps · Agile

    section.section.section_contact#contact(aria-labelledby="contact-title")
      .center.contact-layout
        .contact-copy
          p.eyebrow(data-aos="animation-scale-y") Contact
          h2.section-title#contact-title(data-aos="animation-scale-y" data-aos-delay="100") Let’s build something dependable.
          p(data-aos="animation-translate-y" data-aos-delay="200") Have a role, product or freelance project in mind? Send the details and I’ll get back to you.
          address.contact-details(data-aos="animation-translate-y" data-aos-delay="250")
            a(href="mailto:vishwajayanth3@gmail.com") vishwajayanth3@gmail.com
            a(href="tel:+919345321016") +91 9345321016
            span Tamil Nadu, India
            a(href="https://github.com/Vishwa2706" target="_blank" rel="noopener noreferrer") GitHub
            a(href="https://www.linkedin.com/in/vishwa-settu/" target="_blank" rel="noopener noreferrer") LinkedIn
        form.contact-form.js-contact-form(data-aos="animation-translate-y" data-aos-delay="150" novalidate)
          .form-field
            label(for="name") Name
            input#name(type="text" name="name" autocomplete="name" required minlength="2" maxlength="80" aria-describedby="name-error")
            span.form-error#name-error
          .form-field
            label(for="email") Email
            input#email(type="email" name="email" autocomplete="email" required maxlength="254" aria-describedby="email-error")
            span.form-error#email-error
          .form-field
            label(for="subject") Subject or enquiry type
            input#subject(type="text" name="subject" required minlength="3" maxlength="120" aria-describedby="subject-error")
            span.form-error#subject-error
          .form-field.form-field_honeypot(aria-hidden="true")
            label(for="companyWebsite") Company website
            input#companyWebsite(type="text" name="companyWebsite" tabindex="-1" autocomplete="off")
          .form-field
            label(for="message") Message
            textarea#message(name="message" required minlength="10" maxlength="3000" rows="6" aria-describedby="message-error")
            span.form-error#message-error
          button.btn.btn_purple.form-submit(type="submit") Send Message
          p.form-status.js-form-status(role="status" aria-live="polite")
          p.form-fallback If the form is unavailable, email me directly at #[a(href="mailto:vishwajayanth3@gmail.com") vishwajayanth3@gmail.com].
      .contact-art(data-aos="animation-scale" aria-hidden="true")
        img.contact-art__layer.contact-art__layer_1(src="img/figures-1.png" alt="" width="900" height="700" loading="lazy")
        img.contact-art__layer.contact-art__layer_2.js-parallax(src="img/figures-2.png" alt="" width="900" height="700" loading="lazy" data-scale="1.08" data-orientation="up")
        img.contact-art__layer.contact-art__layer_3.js-parallax(src="img/figures-3.png" alt="" width="900" height="700" loading="lazy" data-scale="1.1" data-orientation="down")
        img.contact-art__layer.contact-art__layer_4(src="img/figures-4.png" alt="" width="900" height="700" loading="lazy")
        img.contact-art__layer.contact-art__layer_5.js-parallax(src="img/figures-5.png" alt="" width="900" height="700" loading="lazy" data-scale="1.12" data-orientation="up")
        img.contact-art__layer.contact-art__layer_6.js-parallax(src="img/figures-6.png" alt="" width="900" height="700" loading="lazy" data-scale="1.08" data-orientation="down")

  footer.site-footer
    .center.site-footer__inner
      p © #[span.js-year] Vishwa S. Built with care.
      a.js-scroll(href="#top") Back to top
    img.site-footer__cube.site-footer__cube_1.js-parallax(src="img/footer-cube-1.png" alt="" width="600" height="500" loading="lazy" data-scale="1.08" data-orientation="down" aria-hidden="true")
    img.site-footer__cube.site-footer__cube_2.js-parallax(src="img/footer-cube-2.png" alt="" width="600" height="500" loading="lazy" data-scale="1.1" data-orientation="up" aria-hidden="true")
